# -----------------------------------
# JARVIS Core v1.0 AUTONOMOUS RESEARCH + DEVICE MESH configuration
# -----------------------------------

# mock | auto | openai | deepseek | alibaba | openrouter | ollama | openai-compatible | vercel-ai-gateway
# Use auto to let JARVIS choose across every configured provider.
JARVIS_LLM_PROVIDER=auto

# single | auto | quality | economy | china | free | local
JARVIS_MODEL_ROUTING=auto
JARVIS_REASONING_EFFORT=max

# ---- Multi-model Council ------------------------------------------------
# off | auto | always | manual
# always = normal questions go through independent answers -> cross-examination -> arbiter.
JARVIS_COUNCIL_MODE=always
# 0 = ask every configured model route. Set a number to cap cost/latency.
JARVIS_COUNCIL_MAX_MODELS=0
JARVIS_COUNCIL_MIN_MODELS=2
JARVIS_COUNCIL_CONCURRENCY=6
JARVIS_COUNCIL_TIMEOUT_MS=90000
JARVIS_COUNCIL_CRITIQUE_ROUND=true

# ---- OpenAI -----------------------------------------------------------
# Current flagship route: GPT-5.6 Sol.
OPENAI_API_KEY=

# ---- DeepSeek (China) -------------------------------------------------
# Supports DeepSeek V4 Pro / Flash through the official API.
DEEPSEEK_API_KEY=

# ---- Alibaba Cloud Model Studio (China / international regions) -------
# Gives one OpenAI-compatible gateway for Qwen + selected Kimi/GLM/MiniMax models.
DASHSCOPE_API_KEY=
# Recommended: paste your workspace-specific OpenAI-compatible base URL from Model Studio.
# Example shape: https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# If omitted, JARVIS uses the legacy international compatible endpoint.
ALIBABA_MODEL_STUDIO_BASE_URL=

# ---- OpenRouter -------------------------------------------------------
# Useful for free/community routes listed by free-llm-api-resources.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Ollama / local ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Comma-separated models actually installed on your machine.
# Example: qwen3:latest,deepseek-r1:14b
JARVIS_OLLAMA_MODELS=

# ---- Legacy single endpoint compatibility ----------------------------
# Used when JARVIS_LLM_PROVIDER is set to a specific legacy provider.
JARVIS_LLM_BASE_URL=
JARVIS_LLM_MODEL=
JARVIS_LLM_API_KEY=
JARVIS_LLM_FALLBACKS=

# JARVIS can ONLY access paths inside this workspace.
# Windows example: C:\Projects\Flore
JARVIS_WORKSPACE_PATH=

# Local persistence
JARVIS_MEMORY_PATH=./data/memory.json
JARVIS_LEARNING_PATH=./data/learning.json
JARVIS_COGNITIVE_MEMORY_PATH=./data/cognitive-memory.json
JARVIS_MODEL_PERFORMANCE_PATH=./data/model-performance.json
JARVIS_API_CATALOG_PATH=./data/public-apis.json
JARVIS_API_SKILLS_PATH=./data/api-skills.json
JARVIS_FREE_LLM_CATALOG_PATH=./data/free-llm-resources.json
JARVIS_APPROVALS_PATH=./data/approvals.json
JARVIS_AUDIT_PATH=./data/audit.jsonl
JARVIS_BACKUP_PATH=./data/backups
JARVIS_TIMEZONE=Asia/Amman

# Self-learning evidence store
JARVIS_LEARNING_ENABLED=true
JARVIS_MAX_LEARNING_ITEMS=5000
JARVIS_API_CATALOG_REFRESH_HOURS=168
JARVIS_FREE_LLM_REFRESH_HOURS=72

# Safety / budgets
JARVIS_APPROVAL_TTL_MINUTES=10
JARVIS_MAX_READ_BYTES=120000
JARVIS_MAX_WRITE_BYTES=240000
JARVIS_MAX_SEARCH_FILES=500
JARVIS_MAX_INDEX_FILES=1500
JARVIS_MAX_AGENT_STEPS=8

# Strongly recommended: leave false.
JARVIS_ALLOW_SECRET_FILES=false
JARVIS_ENABLE_OS_ACTIONS=false

# Optional GitHub token. Public repository reads work without it at lower rate limits.
JARVIS_GITHUB_TOKEN=

# Optional Supabase READ connector. Prefer a publishable/anon key with correct RLS.
JARVIS_SUPABASE_URL=
JARVIS_SUPABASE_KEY=


# ---- Device Mesh v0.7 ---------------------------------------------------
JARVIS_DEVICE_MESH_PATH=./data/device-mesh.json
JARVIS_DEVICE_MESH_KEY_PATH=./data/.device-mesh.key
JARVIS_DEVICE_PERMISSIONS_PATH=./data/device-permissions.json
JARVIS_DEVICE_PAIRING_TTL_MINUTES=5
JARVIS_PERMISSION_REQUEST_TTL_MINUTES=15
JARVIS_DEVICE_OFFLINE_AFTER_SECONDS=120
# Optional. If blank, JARVIS creates data/.device-mesh.key with a local random secret.
JARVIS_DEVICE_MESH_SECRET=

# Health Vault is disabled until this is set to exactly 32 random bytes as base64.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# OpenSSL:   openssl rand -base64 32
JARVIS_HEALTH_VAULT_KEY=
JARVIS_HEALTH_VAULT_PATH=./data/health-vault.jsonl

# Tencent BrowserSkill CLI. JARVIS never asks BrowserSkill for browser cookies/tokens.
JARVIS_BROWSERSKILL_BIN=bsk
JARVIS_BROWSERSKILL_HOME=

# JARVIS v0.8 Knowledge Fabric
JARVIS_KNOWLEDGE_STORE_PATH=./data/knowledge-store.json
JARVIS_MAX_KNOWLEDGE_CHUNKS=20000
JARVIS_KNOWLEDGE_CHUNK_CHARS=3200
JARVIS_KNOWLEDGE_CHUNK_OVERLAP=320
JARVIS_MAX_KNOWLEDGE_FILE_BYTES=8000000
KAGGLE_API_TOKEN=
HF_TOKEN=
FRED_API_KEY=
OPENALEX_API_KEY=
# SEC asks automated clients to identify themselves. Replace with a real contact email.
SEC_USER_AGENT=Huthayfa-JARVIS your-email@example.com

# ---- JARVIS v0.9 Research & Trading Intelligence -----------------------
JARVIS_RESEARCH_STORE_PATH=./data/research-store.json
JARVIS_TRADING_STATE_PATH=./data/trading-state.json
JARVIS_MT5_BRIDGE_PATH=./bridge/mt5_bridge.py
JARVIS_PYTHON_BIN=py
JARVIS_MT5_MAGIC=909090
JARVIS_TRADING_SYMBOLS=XAUUSD
JARVIS_MAX_TRADE_VOLUME=0.10
JARVIS_MAX_RISK_PER_TRADE_PCT=0.50
JARVIS_MAX_DAILY_LOSS_PCT=2.00
# Optional explicit MT5 terminal/account values. Prefer an already logged-in local terminal.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
# Random secret passed to Telegram setWebhook(secret_token=...)
TELEGRAM_WEBHOOK_SECRET=

# ---- JARVIS v1.0 Autonomous Scientist -----------------------------------
# Lifecycle gates are code-enforced: validated -> paper -> shadow -> promoted.
# No new secret is required for the lifecycle engine. Live MT5 still requires
# an explicit time-limited live permit and all v0.9 risk caps remain active.

# JARVIS Reach / Agent-Reach capability layer
JARVIS_AGENT_REACH_BIN=agent-reach
# Boss Zhipin dedicated loopback Chrome DevTools endpoint (optional)
JARVIS_BOSS_CDP_URL=http://127.0.0.1:9222

# JARVIS v1.3 Research Factory / observability
JARVIS_RESEARCH_FACTORY_PATH=./data/research-factory.json
JARVIS_RESEARCH_DATASET_DIR=data/research-datasets
JARVIS_TRACE_PATH=./data/traces.jsonl

# ---- ARCHEON v1.4 Mission Control / Safety / Memory ----------------------
JARVIS_MISSIONS_PATH=./data/missions.json
JARVIS_MEMORY2_PATH=./data/memory-v2.json
JARVIS_PLUGIN_REGISTRY_PATH=./data/plugins.json
JARVIS_SECURITY_STATE_PATH=./data/security-state.json
JARVIS_CLAIM_GRAPH_PATH=./data/claim-graph.json

# ---- ARCHEON v1.5 Autonomous Cognition ---------------------------------
JARVIS_AUTONOMY_PATH=./data/autonomy.json
JARVIS_BELIEFS_PATH=./data/beliefs.json
JARVIS_COGNITION_QUEUE_PATH=./data/cognition-queue.json
JARVIS_COGNITION_HISTORY_PATH=./data/cognition-history.json
# Worker cadence; minimum enforced in code is 60 seconds.
JARVIS_COGNITION_INTERVAL_SECONDS=300
# Run deeper idle maintenance every N cognition cycles.
JARVIS_COGNITION_IDLE_EVERY=12
